#!/usr/bin/zsh

source "$HOME/.config/shell/common/functions"

print_info "system:"
paru -Syu
echo

print_info "nvim:"
~/dotfiles/src/neovim/build
echo

nvim --headless \
  -c "lua Delete_unused_packs()" \
  -c "!rm -rf ~/.config/nvim/nvim-pack-lock.json" \
  -c "lua vim.pack.update(nil, { force = true })" \
  -c "quit"
echo
echo

nvim --headless -c 'autocmd User MasonUpdateAllComplete quitall' -c 'lua require("plugins.lsp.mason")' -c 'MasonUpdateAll'
echo

print_info "ai agents:"
curl -fsSL https://chatgpt.com/codex/install.sh | \
  CODEX_INSTALL_DIR="$HOME/.local/libexec" CODEX_NON_INTERACTIVE=1 PATH="$HOME/.local/libexec:$PATH" sh
curl -fsSL https://claude.ai/install.sh | bash
curl -fsSL https://dev.meta.ai/install.sh | sh
echo

print_info "zinit:"
(
  source /usr/share/zinit/zinit.zsh || exit
  source "${ZINIT[BIN_DIR]}/zinit-autoload.zsh" || exit
  # Paru updates the packaged Zinit; bulk plugin updates also call self-update.
  .zinit-self-update() { return 0; }
  zinit update --parallel
)
echo

print_info "tmux:"
~/.tmux/plugins/tpm/bin/update_plugins all
echo

print_info "rust:"
rustup update
echo

print_info "cargo:"
cargo install-update -a
echo

print_info "asdf:"
asdf plugin update --all
echo

print_info "firmware:"
fwupdmgr get-updates
echo

print_info "corepack:"
npm install --global corepack@latest
echo

print_info "npm:"
npm install -g npm@latest
