[Unit]
Description=Signalbox host for NTS (API, browser UI and orchestration)
Documentation=file://%h/.config/signalbox/README.md
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/.config/signalbox
# Start the coordinator with the host. Remove to run the routes without one.
Environment=SIGNALBOX_NTS_COORDINATOR=1
# Agents inherit the host's environment, and NTS's gate requires host tools by
# name (ANDROID_HOME, JAVA_HOME, ...). A systemd unit's environment is minimal,
# so the host runs inside a zsh login shell: agents see what a terminal sees.
# JAVA_HOME is set by .zshrc (interactive only) from asdf's current java; the
# same derivation runs here, because a login shell never reads .zshrc.
ExecStart=/usr/bin/zsh -lc 'java=$$(asdf which java) && export JAVA_HOME=$${java:A:h:h} JDK_HOME=$${java:A:h:h}; exec node server.ts'
# Agent sessions run in their own systemd scope (tmux), so stopping or
# restarting this unit never ends them; the host recovers them on start.
Restart=on-failure
RestartSec=10
# CPUs 4-5 are NTS's measurement cores.
CPUAffinity=0-3 6-31
Nice=5

[Install]
WantedBy=default.target
