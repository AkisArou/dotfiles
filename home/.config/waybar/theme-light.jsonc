// waybar in the light theme: formats whose labels are coloured; config.jsonc
// includes it through theme.jsonc.
{
  "pulseaudio": {
    "format": "<span color='#0000FF'>{icon}</span> {volume}%",
  },
  "memory": {
    "format": "<span color='#0000FF'>MEM</span> {}%",
  },
  "cpu": {
    "format": "<span color='#0000FF'>CPU</span> {usage}%",
  },
  "battery": {
    "format": "<span color='#0000FF'>BAT</span> {capacity}%",
    "format-charging": "<span color='#0000FF'>BAT</span> {capacity}%",
  },
  "backlight": {
    "format": "<span color='#0000FF'>BRT</span> {percent}%",
  },
  "bluetooth": {
    "format": "<span color='#0000FF'>BT</span> {status}",
  },
  "custom/aibar": {
    "format": "<span color='#0000FF'>{text}</span>",
  },
}
