    },
    "text": {
      "feedback": { "warning": { "base": "$hue.yellow.400" } }
    },
    "border": { "base": "#DDDDDD" },
    "diff": { "lineNumber": { "text": "#237893" } },
    "markdown": {
      "heading": "#800000",
      "code": "#800000",
      "blockQuote": "#0451A5",
