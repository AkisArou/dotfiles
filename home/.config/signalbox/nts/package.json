{
  "name": "signalbox-nts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The NTS application on the Signalbox SDK",
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "sdk": "node ../sbn.ts sdk",
    "start": "node server.ts",
    "dev": "node ../sbn.ts sdk && node server.ts",
    "tui": "node ../sbn.ts sdk && node scripts/tui.ts",
    "check": "node ../sbn.ts sdk && tsc -p tsconfig.json && tsc -p tsconfig.tui.json",
    "test": "node ../sbn.ts sdk && node --test host/*.test.ts status/*.test.ts orchestration/*.test.ts",
    "test:tui": "node ../sbn.ts sdk && node scripts/tui.ts --test",
    "doctor": "node ../sbn.ts sdk && node scripts/doctor.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "@opentui/core": "0.9.0",
    "@opentui/react": "0.9.0",
    "@signalbox/kit": "file:/home/akisarou/Projects/signalbox/kit",
    "@stylexjs/stylex": "0.19.2",
    "@tanstack/react-router": "1.170.46",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "19.3.1",
    "react-devtools-core": "^7.0.1",
    "react-dom": "19.3.1",
    "signalbox": "file:/home/akisarou/Projects/signalbox/signalbox",
    "zod": "^4.3.6"
  },
  "dependenciesMeta": {
    "signalbox": {
      "injected": true
    },
    "@signalbox/kit": {
      "injected": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  }
}
