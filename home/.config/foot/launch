#!/usr/bin/zsh

FONT=HasklugNerdFontMono-Regular:size=

if [[ $ULTRAWIDE == 1 ]]; then
  FONT="$FONT"11
else
  FONT="$FONT"10
fi

# Open in the theme in use (~/.local/bin/theme); later switches signal foot.
THEME_FILE=${XDG_STATE_HOME:-$HOME/.local/state}/theme/current
[[ -r $THEME_FILE ]] && THEME=$(<$THEME_FILE)
[[ $THEME == (light|dark) ]] || THEME=dark

foot --font="$FONT" -o initial-color-theme=$THEME "$@"
