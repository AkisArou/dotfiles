gtk-color-scheme = "fg_color:#3b3b3b\nbg_color:#ffffff\nbase_color:#ffffff\ntext_color:#3b3b3b\nselected_bg_color:#add6ff\nselected_fg_color:#000000\ntooltip_bg_color:#f8f8f8\ntooltip_fg_color:#616161"
gtk-icon-theme-name = "Adwaita"
gtk-theme-name = "VSCode-Light"

style "vscode-light-default" {
  GtkWidget::focus-line-width = 1
  GtkWidget::focus-padding = 1
  GtkButton::default-border = { 0, 0, 0, 0 }
  GtkButton::default-outside-border = { 0, 0, 0, 0 }

  fg[NORMAL] = @fg_color
  fg[PRELIGHT] = @fg_color
  fg[ACTIVE] = @fg_color
  fg[SELECTED] = @selected_fg_color
  fg[INSENSITIVE] = "#a0a0a0"

  bg[NORMAL] = @bg_color
  bg[PRELIGHT] = "#e0e0e0"
  bg[ACTIVE] = "#add6ff"
  bg[SELECTED] = @selected_bg_color
  bg[INSENSITIVE] = "#f3f3f3"

  base[NORMAL] = @base_color
  base[PRELIGHT] = "#f3f3f3"
  base[ACTIVE] = "#add6ff"
  base[SELECTED] = @selected_bg_color
  base[INSENSITIVE] = "#f3f3f3"

  text[NORMAL] = @text_color
  text[PRELIGHT] = @text_color
  text[ACTIVE] = @text_color
  text[SELECTED] = @selected_fg_color
  text[INSENSITIVE] = "#a0a0a0"
}

class "*" style "vscode-light-default"
