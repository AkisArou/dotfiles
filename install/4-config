#!/usr/bin/zsh

set -e

source "$HOME/dotfiles/home/.config/shell/common/functions"

clear
echo "Applying system config..."
echo "-------------------------"

sudo usermod -aG wheel,audio,video,docker,network,adm,input,storage,wireshark "$USER"

print_info "Enabling systemctl daemons..."
loginctl enable-linger
sudo systemctl enable --now systemd-networkd
sudo systemctl enable --now systemd-resolved
sudo systemctl enable --now iwd
sudo systemctl enable --now bluetooth
sudo systemctl enable --now sshd
sudo systemctl enable --now avahi-daemon
sudo systemctl enable --now power-profiles-daemon
sudo systemctl enable --now performance.service
sudo systemctl enable --now paccache.timer

print_info "Setting up tmux..."
if [[ -e "$HOME/.tmux/plugins/tpm/.git" ]]; then
  git -C "$HOME/.tmux/plugins/tpm" pull --ff-only
else
  git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
fi
"$HOME/.tmux/plugins/tpm/bin/install_plugins"
if tmux has-session 2>/dev/null; then
  tmux source-file "$HOME/.tmux.conf"
fi
systemctl --user daemon-reload
systemctl --user enable --now tmux-save-on-shutdown.service

print_info "Setting up asdf..."
# Generate asdf completions
COMPLETIONS_DIR="${ASDF_DATA_DIR:-$HOME/.asdf}/completions"
PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"

if [ ! -d "$COMPLETIONS_DIR" ]; then
  mkdir -p "$COMPLETIONS_DIR"
  asdf completion zsh >"$COMPLETIONS_DIR/_asdf"
fi

## Add asdf plugins
asdf plugin add nodejs https://github.com/asdf-vm/asdf-nodejs.git
asdf plugin add java https://github.com/halcyon/asdf-java.git
asdf plugin add kotlin https://github.com/asdf-community/asdf-kotlin.git

# Read .tool-versions file and install the specified versions
cd ~
asdf install

print_info "Configuring java... (for the current session only)"
. "$HOME/.asdf/plugins/java/set-java-home.zsh"

print_info "Setting up docker..."
ls -al /dev/kvm
sudo usermod -aG kvm $USER
sudo usermod -aG docker $USER
docker --version
# .socket instead of .service to start docker deamon only when needed
sudo systemctl enable --now docker.socket
docker context use default
docker compose version

print_info "Configuring NodeJS..."
corepack enable pnpm
corepack enable yarn
asdf reshim nodejs

print_info "Setting xdg default web browser..."
ORIGINAL_BROWSER=$BROWSER
unset BROWSER
xdg-settings set default-web-browser brave-browser.desktop
export BROWSER=$ORIGINAL_BROWSER

print_info "Downloading tldr cache..."
tldr --update

print_info "Generating zsh completions..."
~/dotfiles/install/setup-completions

print_info "Installing tmp plugins..."
~/.tmux/plugins/tpm/bin/clean_plugins all

print_info "Removing thunar extra desktop files..."
sudo rm -rf /usr/share/applications/{thunar-bulk-rename.desktop,thunar-settings.desktop}

print_info "Setting up git remote..."
if ! remote_url=$(git -C "$HOME/dotfiles" remote get-url origin 2>/dev/null); then
  echo "No remote 'origin' configured. Adding SSH origin..."
  git -C "$HOME/dotfiles" remote add origin git@github.com:AkisArou/dotfiles.git
elif [[ "$remote_url" != git@github.com:AkisArou/dotfiles.git ]]; then
  echo "Switching dotfiles origin to SSH..."
  git -C "$HOME/dotfiles" remote set-url origin git@github.com:AkisArou/dotfiles.git
else
  echo "Dotfiles origin is already configured via SSH."
fi

print_success "DONE!"
