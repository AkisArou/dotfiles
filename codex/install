#!/usr/bin/zsh

set -euo pipefail

codex_dir="${0:A:h}"
user_config="${CODEX_HOME:-$HOME/.codex}/config.toml"

mkdir -p -- "$(dirname -- "$user_config")"

# Detach old symlinks before Codex can write through them into the repository.
# Preserve their contents; existing regular user configs are left untouched.
if [[ -L "$user_config" ]]; then
  config_copy=$(mktemp "${user_config}.XXXXXX")
  trap 'rm -f -- "$config_copy"' EXIT
  cp -L -- "$user_config" "$config_copy"
  mv -fT -- "$config_copy" "$user_config"
  trap - EXIT
fi

# A missing user config is fine: Codex inherits these defaults and creates its
# own user config when it needs to persist a choice or project trust entry.
sudo mkdir -p /etc/codex
sudo ln -sfnT -- "$codex_dir/config.toml" /etc/codex/config.toml

printf '%s\n' "Codex defaults installed; local settings stay in $user_config."
