# The nts Apple lane's macOS VM (quickemu forwards guest :22 to host :22220).
Host nts-mac
  HostName 127.0.0.1
  Port 22220
  User akisarou

Host nts-win
  HostName 127.0.0.1
  Port 22221
  User Quickemu
