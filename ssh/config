AddKeysToAgent yes

# Local host
Host 192.168.1.2
  HostName 192.168.1.2
  User akisarou

# Default settings
Host *
  Protocol 2
  ConnectTimeout 10

# Local network hosts
Host 192.168.*.*
  Protocol 2
  Compression no

