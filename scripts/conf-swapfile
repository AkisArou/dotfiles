#!/usr/bin/zsh

set -e -o pipefail

if ((EUID == 0)); then
  print -u2 "Run this script as your normal user; it uses sudo when needed."
  exit 1
fi

source "$HOME/dotfiles/scripts/library"

# Keep zram preferred, with disk swap as a fallback. Never reformat an existing file.
if sudo test -e /swapfile || sudo test -L /swapfile; then
  if sudo test -L /swapfile || ! sudo test -f /swapfile; then
    print_failure "/swapfile must be a regular swapfile; leaving it untouched."
    exit 1
  fi
  if [[ "$(sudo blkid --probe --match-tag TYPE --output value /swapfile)" != swap ]]; then
    print_failure "Existing /swapfile is not valid swap; leaving it untouched."
    exit 1
  fi
else
  # Use the physical disk's capacity, rather than partition size or free space.
  swap_device=$(findmnt --noheadings --nofsroot --output SOURCE --target /)
  disk_bytes=$(lsblk --bytes --inverse --noheadings --raw --output TYPE,SIZE "$swap_device" |
    awk '$1 == "disk" { if ($2 > size) size = $2 } END { printf "%.0f\n", size }')
  if ((disk_bytes == 0)); then
    print_failure "Cannot determine the disk capacity for /swapfile."
    exit 1
  fi

  swap_size=16G
  if ((disk_bytes >= 900000000000)); then
    swap_size=32G
  fi
  print_info "Creating a $swap_size swapfile..."
  sudo mkswap --file --size "$swap_size" /swapfile
fi

sudo chown root:root /swapfile
sudo chmod 600 /swapfile
create_symlink "$HOME/dotfiles/systemd/system/swapfile.swap" /etc/systemd/system/swapfile.swap
sudo systemctl daemon-reload
sudo systemctl enable --now swapfile.swap
swapon --show
