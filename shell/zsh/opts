#!/usr/bin/zsh

autoload -Uz add-zsh-hook

WORDCHARS=${WORDCHARS//\//}

unsetopt BEEP
setopt AUTO_CD
setopt GLOB_DOTS
setopt NUMERIC_GLOB_SORT
setopt NOMATCH
setopt MENU_COMPLETE
setopt EXTENDED_GLOB
setopt INTERACTIVE_COMMENTS

bindkey -M menuselect '^N' down-line-or-history
bindkey -M menuselect '^P' up-line-or-history

# Open nvim with Alt+e like fish
bindkey -s '\ee' 'v\n'

# PRECMD
_dotfiles_encode_uri_path() {
  emulate -L zsh

  local LC_ALL=C
  local character encoded_character
  local encoded_path=

  for character in ${(s::)1}; do
    if [[ $character == [A-Za-z0-9._~/-] ]]; then
      encoded_path+=$character
    else
      printf -v encoded_character '%%%02X' "'$character"
      encoded_path+=$encoded_character
    fi
  done

  REPLY=$encoded_path
}

print_osc7() {
  _dotfiles_encode_uri_path "$PWD"
  printf '\033]7;file://%s%s\033\\' "${HOST:-localhost}" "$REPLY"
}

print_osc133() {
  printf '\033]133;A\007'
}

add-zsh-hook precmd print_osc7
add-zsh-hook precmd print_osc133
